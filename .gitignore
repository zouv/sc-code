# =============================================================================
# ScCode .gitignore
# =============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────────────────────
/dist/
/out/
/build/
*.tsbuildinfo

# ── Rust / Cargo ─────────────────────────────────────────────────────────────
**/target/

# ── WASM build artifacts (wasm-pack output) ──────────────────────────────────
**/pkg/

# ── Extensions (auto-installed on first dev/build via npm run setup) ──────────
/extensions/

# ── Cargo.lock for library crates ───────────────────────────────────────────
# Library lock files should not be committed (Cargo best practice).
# The workspace application lock (/Cargo.lock) IS committed.
sc-code-extension-sdk/Cargo.lock
extensions-rust/Cargo.lock
examples/**/Cargo.lock

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/logs/

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini
ehthumbs.db

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
aws-credentials.json

# ── Tauri generated ──────────────────────────────────────────────────────────
src-tauri/gen/

# ── Test / Coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tgz
*.vsix
.turbo/
.cache/
.parcel-cache/

# ── Cloudflare Wrangler (marketplace-proxy dev state) ────────────────────────
infrastructure/marketplace-proxy/.wrangler/

# ── ScCode ephemeral project state (never commit) ─────────────────────────────────────
# Memory, bench results, and other generated state live in ~/.sc-code/.
# Only .sc-code/rules/ and .sc-code/skills/ are meant to be committed.
.sc-code/*
!.sc-code/rules/
!.sc-code/skills/
MEMORY.md
.kilo/

# ScCode local generated runtimes, build caches, fixtures and diagnostics
/.runtime/
*.partial
*.dmp
*.stackdump
# Transitional output locations from previous versions (never commit)
/src-tauri/tauri.runtime.conf.json
/src-tauri/runtime/
/extensions-meta.json
/public/builtin-extensions.js

# Other local scratch/report state (dependency manifests and lockfiles remain tracked)
/artifacts/
/.runtime-*.log
*.tmp
*.bak
*.orig
*.rej
/playwright-report/
/test-results/

# Legacy package output (pre-dist); new packages go to /dist/ (ignored above)
/packages/

# Local AI/editor session settings (shared skills and rules remain tracked)
/.claude/settings.local.json
/.claude/sessions/
/.codex/sessions/
/.codex/logs/
/.codex/config.local.toml
/.opencode/sessions/
/.history/

# Local service state / database sidecars (not source fixtures)
/agent/**/*.db-shm
/agent/**/*.db-wal
